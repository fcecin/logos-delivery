# Source of truth for the RLN simulator E2E run (ci-rln-simulator.yml).
# workflow_dispatch inputs override any value here per-run (blank input = use this file).
BRANCH=master
# The simulator is a separate repository. Pin it, so a change there cannot turn
# this job red on its own, and so a bump is a reviewable commit here.
# This commit carries a known defect in deploy_rln_contract.sh that fails the
# run at exit 127. Bump this once that is fixed upstream.
SIMULATOR_COMMIT=0faeda33aed2aeaff581f6789b3bed3a0599f68f
NUM_NODES=6
MSG_LIMIT=30
EPOCH_SEC=120
